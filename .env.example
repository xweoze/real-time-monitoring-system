# 발급받은 기관별 상세 API URL을 넣고 키 위치를 {service_key}로 표시합니다.
# 아래 주소는 예시 형식이므로 활용 신청 화면의 실제 호출 URL로 교체해야 합니다.
export RTLS_DISASTER_API_URL='https://api.example.go.kr/disaster/messages?serviceKey={service_key}&returnType=json&numOfRows=100'
export RTLS_DISASTER_API_KEY='발급받은_행정안전부_API_키'

export RTLS_WEATHER_API_URL='https://apihub.kma.go.kr/api/example?authKey={service_key}'
export RTLS_WEATHER_API_KEY='발급받은_기상청_API_키'

# 최소 30초, 기본 300초
export RTLS_PUBLIC_DATA_INTERVAL='300'

# 역지오코딩은 관제 화면에서 '주소 확인'을 누를 때만 호출됩니다.
# Kakao Local API 예시
export RTLS_GEOCODER_PROVIDER='kakao'
export RTLS_GEOCODER_URL='https://dapi.kakao.com/v2/local/geo/coord2address.json?x={lng}&y={lat}'
export RTLS_GEOCODER_API_KEY='발급받은_Kakao_REST_API_키'

# Nominatim을 사용할 경우 아래처럼 변경합니다. 공개 서버는 소규모 시험에만 사용하세요.
# export RTLS_GEOCODER_PROVIDER='nominatim'
# export RTLS_GEOCODER_URL='https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat={lat}&lon={lng}&zoom=18'
# export RTLS_GEOCODER_API_KEY=''
# export RTLS_GEOCODER_USER_AGENT='RTLS-Monitoring/1.0 contact@example.com'

# n8n Webhook 알림. 설정하지 않으면 외부 전송은 완전히 비활성화됩니다.
# SOS, 위험구역 진입, 신호 끊김, 배터리 부족, 장시간 무동작과
# WARNING/CRITICAL 공공 재난 알림만 전송합니다.
export RTLS_N8N_WEBHOOK_URL='https://n8n.example.com/webhook/rtls-alert'
export RTLS_N8N_WEBHOOK_SECRET='충분히_긴_공유_비밀값'
export RTLS_N8N_WEBHOOK_TIMEOUT='5'

# 기본 포트는 8080이며 Playwright는 충돌 방지를 위해 8091을 사용합니다.
# export RTLS_PORT='8080'
